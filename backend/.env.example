# Copy this file to `.env` in the same directory and fill in the real values.
# NEVER commit the real `.env` file. It is already in .gitignore.

# Postgres connection string from Supabase.
#
# IMPORTANT: use the **Session pooler** connection string, not the direct one.
# The direct connection (db.<project>.supabase.co) is IPv6-only and will fail
# from most home networks and from Render/Vercel free tiers (which are IPv4-only).
# The Session pooler works over IPv4 and is Supabase's recommended path.
#
# To find it: Supabase project -> Settings -> Database -> Connection string ->
#   Session pooler tab. Copy that string.
# It looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Note that the username is `postgres.<project-ref>`, not just `postgres`.
# Replace <password> with the database password you set when creating the project.
# If your password contains @ : / ? # [ ] ! you must URL-encode those characters
# (e.g. @ -> %40).
DATABASE_URL=

# Frontend origin for CORS (Cross-Origin Resource Sharing) in production.
# Required. Set to your Vercel URL once deployed, e.g. https://food-budget.vercel.app
FRONTEND_ORIGIN=

# Comma-separated list of extra origins to allow in CORS — for local development only.
# Set this in your local .env file. Leave empty (or omit) in production (Render).
# Example: http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
CORS_DEV_ORIGINS=
